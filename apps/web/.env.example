# Supabase Configuration
# The Supabase project URL and anonymous key are strictly required for authentication.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Frontend Site Configuration
# NEXT_PUBLIC_SITE_URL is used for authentication redirects.
# Important: Supabase redirect URLs must be configured in the Supabase project for the local site URL to allow logins.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Backend API Target
# NEXT_PUBLIC_API_URL controls where the frontend sends authenticated API requests.
# If omitted, it gracefully defaults to http://localhost:3000.
NEXT_PUBLIC_API_URL=http://localhost:3000
