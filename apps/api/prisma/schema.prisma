generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id            String            @id @default(uuid())
  display_name  String?
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt
  memberships   WorkspaceMember[]
  api_keys      ApiKey[]
  saved_reports SavedReport[]

  @@map("profiles")
}

model Workspace {
  id                         String                      @id @default(uuid())
  name                       String
  slug                       String                      @unique
  status                     String                      @default("ACTIVE")
  created_at                 DateTime                    @default(now())
  updated_at                 DateTime                    @updatedAt
  members                    WorkspaceMember[]
  phone_numbers              PhoneNumber[]
  campaigns                  Campaign[]
  buyers                     Buyer[]
  vendors                    Vendor[]
  campaign_buyers            CampaignBuyer[]
  blocked_callers            BlockedCaller[]
  calls                      Call[]
  recordings                 Recording[]
  usage_records              UsageRecord[]
  billing_customer           BillingCustomer?
  subscription               Subscription?
  invoices                   Invoice[]
  api_keys                   ApiKey[]
  outbound_webhooks          OutboundWebhook[]
  invitations                WorkspaceInvitation[]
  balance                    WorkspaceBalance?
  wallet_txs                 WalletTransaction[]
  callReservations           CallReservation[]
  callReservationExtensions  CallReservationExtension[]
  saved_reports              SavedReport[]
  workspaceMemberPermissions WorkspaceMemberPermission[]
  securityAuditLogs          SecurityAuditLog[]
  callCommercials            CallCommercial[]
  callDisputes               CallDispute[]
  callFinancialAdjustments   CallFinancialAdjustment[]

  @@map("workspaces")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model WorkspaceInvitation {
  id           String           @id @default(uuid())
  workspace_id String
  email        String
  role         WorkspaceRole
  token_hash   String           @unique
  status       InvitationStatus @default(PENDING)
  expires_at   DateTime
  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt
  created_by   String? // The user_id who created the invitation

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  participant_type WorkspaceParticipantType @default(INTERNAL)
  vendor_id        String?
  buyer_id         String?

  vendor Vendor? @relation(fields: [vendor_id], references: [id], onDelete: SetNull)
  buyer  Buyer?  @relation(fields: [buyer_id], references: [id], onDelete: SetNull)

  @@index([workspace_id])
  @@index([email])
  @@map("workspace_invitations")
}

enum WorkspaceParticipantType {
  INTERNAL
  VENDOR
  BUYER
}

model Vendor {
  id           String   @id @default(uuid())
  workspace_id String
  name         String
  status       String   @default("ACTIVE")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  workspace             Workspace             @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  workspace_members     WorkspaceMember[]
  workspace_invitations WorkspaceInvitation[]
  phone_numbers         PhoneNumber[]
  call_commercials      CallCommercial[]

  @@index([workspace_id])
  @@map("vendors")
}

model WorkspaceMember {
  id           String        @id @default(uuid())
  workspace_id String
  user_id      String
  role         WorkspaceRole @default(MEMBER)
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt
  profile      Profile       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  workspace    Workspace     @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  participant_type WorkspaceParticipantType @default(INTERNAL)
  vendor_id        String?
  buyer_id         String?

  vendor Vendor? @relation(fields: [vendor_id], references: [id], onDelete: SetNull)
  buyer  Buyer?  @relation(fields: [buyer_id], references: [id], onDelete: SetNull)

  workspaceMemberPermissions WorkspaceMemberPermission[]
  audit_actions              SecurityAuditLog[] @relation("AuditLogActor")

  @@unique([workspace_id, user_id])
  @@map("workspace_members")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
  IGNORED
}

model WebhookEvent {
  id              String        @id @default(uuid())
  provider        String // 'telnyx', 'twilio', etc.
  providerEventId String // The ID given by the provider
  status          WebhookStatus @default(PENDING)
  payload         Json
  error           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([provider, providerEventId])
  @@index([status])
  @@map("webhook_events")
}

enum PhoneNumberStatus {
  ACTIVE
  RELEASED
  PROVISIONING
}

model PhoneNumber {
  id                 String            @id @default(uuid())
  workspace_id       String
  phone_number       String            @unique
  name               String?
  provider           String
  provider_number_id String?
  connection_id      String?
  status             PhoneNumberStatus @default(ACTIVE)
  campaign_id        String?
  vendor_id          String?
  number_type        String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  campaign  Campaign? @relation(fields: [campaign_id], references: [id], onDelete: SetNull)
  vendor    Vendor?   @relation(fields: [vendor_id], references: [id], onDelete: SetNull)

  @@index([workspace_id])
  @@index([campaign_id])
  @@index([vendor_id])
  @@map("phone_numbers")
}

model Campaign {
  id           String   @id @default(uuid())
  workspace_id String
  name                     String
  status                   String   @default("ACTIVE") // ACTIVE, INACTIVE
  conversion_duration_secs Int?     @default(90)
  duplicate_window_secs    Int?     @default(2592000)
  default_revenue_amount   Decimal? @db.Decimal(12, 4)
  default_payout_amount    Decimal? @db.Decimal(12, 4)
  currency                 String   @default("USD")
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  phone_numbers    PhoneNumber[]
  buyers           CampaignBuyer[]
  calls            Call[]
  call_commercials CallCommercial[]

  @@index([workspace_id])
  @@map("campaigns")
}

model Buyer {
  id                 String   @id @default(uuid())
  workspace_id       String
  name               String
  destination_number String // E.164
  status             String   @default("ACTIVE") // ACTIVE, INACTIVE
  timeout            Int      @default(30)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  workspace             Workspace             @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  workspace_members     WorkspaceMember[]
  workspace_invitations WorkspaceInvitation[]
  campaigns             CampaignBuyer[]
  call_attempts         CallAttempt[]
  call_commercials      CallCommercial[]
  call_disputes         CallDispute[]

  @@index([workspace_id])
  @@map("buyers")
}

model CampaignBuyer {
  id           String   @id @default(uuid())
  workspace_id String
  campaign_id  String
  buyer_id     String
  priority     Int
  status       String   @default("ACTIVE") // ACTIVE, INACTIVE
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  campaign  Campaign  @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  buyer     Buyer     @relation(fields: [buyer_id], references: [id], onDelete: Cascade)

  @@unique([campaign_id, priority])
  @@unique([campaign_id, buyer_id])
  @@index([workspace_id])
  @@map("campaign_buyers")
}

model BlockedCaller {
  id           String   @id @default(uuid())
  workspace_id String
  phone_number String // E.164 normalized
  reason       String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@unique([workspace_id, phone_number])
  @@map("blocked_callers")
}

enum CallState {
  INITIATED
  ROUTING
  COMPLETED
  NO_ANSWER
  FAILED
  CANCELED
}

enum CallAttemptState {
  INITIATED
  RINGING
  ANSWERED
  COMPLETED
  NO_ANSWER
  FAILED
  CANCELED
}

model Call {
  id               String    @id @default(uuid())
  workspace_id     String
  campaign_id      String?
  provider         String
  provider_call_id String    @unique
  from_number      String
  to_number        String
  state            CallState @default(INITIATED)
  duration_secs    Int?
  started_at       DateTime?
  answered_at      DateTime?
  ended_at         DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  workspace                 Workspace                  @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  campaign                  Campaign?                  @relation(fields: [campaign_id], references: [id], onDelete: SetNull)
  attempts                  CallAttempt[]
  recordings                Recording[]
  callReservation           CallReservation?
  callReservationExtensions CallReservationExtension[]
  commercial                CallCommercial?
  duplicate_calls           CallCommercial[]           @relation("DuplicateOfCall")

  @@index([workspace_id])
  @@index([campaign_id])
  @@index([provider_call_id])
  @@map("calls")
}

model CallAttempt {
  id               String           @id @default(uuid())
  call_id          String
  buyer_id         String
  provider_call_id String?          @unique
  state            CallAttemptState @default(INITIATED)
  duration_secs    Int?
  started_at       DateTime?
  answered_at      DateTime?
  ended_at         DateTime?
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt

  call  Call  @relation(fields: [call_id], references: [id], onDelete: Cascade)
  buyer Buyer @relation(fields: [buyer_id], references: [id], onDelete: Cascade)

  @@index([call_id])
  @@index([buyer_id])
  @@map("call_attempts")
}

enum RecordingStatus {
  PENDING
  COMPLETED
  FAILED
}

model Recording {
  id            String          @id @default(uuid())
  workspace_id  String
  call_id       String
  provider_id   String          @unique
  recording_url String?
  duration_secs Int?
  status        RecordingStatus @default(PENDING)
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt

  call      Call      @relation(fields: [call_id], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@index([workspace_id])
  @@index([call_id])
  @@map("recordings")
}

enum UsageType {
  CALL_MINUTE
  PHONE_NUMBER
  RECORDING_STORAGE
}

model UsageRecord {
  id              String    @id @default(uuid())
  workspace_id    String
  type            UsageType
  quantity        Int // E.g. minutes, quantity of numbers, etc
  source_id       String? // The ID of the call, phone number, or recording
  idempotency_key String    @unique
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@index([workspace_id])
  @@index([type])
  @@map("usage_records")
}

enum TransactionType {
  CREDIT
  DEBIT
  REFUND
  ADJUSTMENT
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  UNCOLLECTIBLE
  VOID
}

model Plan {
  id                  String         @id @default(uuid())
  name                String
  description         String?
  provider_product_id String?        @unique
  provider_price_id   String?
  amount              Int? // stored in cents
  currency            String         @default("usd")
  interval            String         @default("month") // month, year
  active              Boolean        @default(true)
  subscriptions       Subscription[]
  created_at          DateTime       @default(now())
  updated_at          DateTime       @updatedAt

  @@map("plans")
}

model BillingCustomer {
  id                   String   @id @default(uuid())
  workspace_id         String   @unique
  provider_customer_id String   @unique
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@map("billing_customers")
}

model Subscription {
  id                       String             @id @default(uuid())
  workspace_id             String             @unique
  plan_id                  String?
  provider_subscription_id String             @unique
  status                   SubscriptionStatus @default(INCOMPLETE)
  current_period_start     DateTime
  current_period_end       DateTime
  cancel_at_period_end     Boolean            @default(false)
  created_at               DateTime           @default(now())
  updated_at               DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  plan      Plan?     @relation(fields: [plan_id], references: [id], onDelete: SetNull)
  invoices  Invoice[]

  @@map("subscriptions")
}

model Invoice {
  id                  String        @id @default(uuid())
  workspace_id        String
  subscription_id     String?
  provider_invoice_id String        @unique
  amount_due          Int
  amount_paid         Int
  status              InvoiceStatus
  currency            String        @default("usd")
  hosted_invoice_url  String?
  invoice_date        DateTime
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt

  workspace    Workspace     @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscription_id], references: [id], onDelete: SetNull)

  @@index([workspace_id])
  @@map("invoices")
}

model ApiKey {
  id            String    @id @default(uuid())
  workspace_id  String
  user_id       String
  name          String
  key_prefix    String
  hashed_secret String
  last_used_at  DateTime?
  revoked_at    DateTime?
  created_at    DateTime  @default(now())

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  profile   Profile   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([workspace_id])
  @@index([key_prefix])
  @@map("api_keys")
}

model OutboundWebhook {
  id               String            @id @default(uuid())
  workspace_id     String
  url              String
  secret_encrypted String
  status           String            @default("ACTIVE") // ACTIVE, INACTIVE
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  workspace        Workspace         @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  deliveries       WebhookDelivery[]

  @@index([workspace_id])
  @@map("outbound_webhooks")
}

model WebhookDelivery {
  id                  String          @id @default(uuid())
  outbound_webhook_id String
  event_id            String          @default(uuid())
  event_type          String
  payload_json        String
  status              String          @default("PENDING") // PENDING, SUCCESS, FAILED
  attempt_count       Int             @default(0)
  next_attempt_at     DateTime?
  last_error          String?
  delivered_at        DateTime?
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  outbound_webhook    OutboundWebhook @relation(fields: [outbound_webhook_id], references: [id], onDelete: Cascade)

  @@unique([outbound_webhook_id, event_id])
  @@index([outbound_webhook_id])
  @@index([status, next_attempt_at])
  @@map("webhook_deliveries")
}

model WorkspaceBalance {
  workspace_id   String   @id
  balance_minor  Int      @default(0)
  balance_micro  BigInt   @default(0)
  reserved_micro BigInt   @default(0)
  currency       String   @default("USD")
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@map("workspace_balances")
}

model WalletTransaction {
  id                  String          @id @default(uuid())
  workspace_id        String
  amount_minor        Int
  amount_micro        BigInt
  currency            String          @default("USD")
  type                TransactionType @default(CREDIT)
  balance_after       Int
  balance_after_micro BigInt
  reference_type      String
  reference_id        String
  idempotency_key     String          @unique
  description         String?
  created_at          DateTime        @default(now())

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@index([workspace_id])
  @@map("wallet_transactions")
}

enum ReservationStatus {
  ACTIVE
  SETTLED
  RELEASED
  EXPIRED
}

model CallReservation {
  id                      String            @id @default(uuid())
  call_id                 String            @unique
  workspace_id            String
  status                  ReservationStatus @default(ACTIVE)
  original_reserved_micro BigInt
  total_reserved_micro    BigInt
  expires_at              DateTime?
  created_at              DateTime          @default(now())
  updated_at              DateTime          @updatedAt

  call                      Call                       @relation(fields: [call_id], references: [id], onDelete: Cascade)
  workspace                 Workspace                  @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  callReservationExtensions CallReservationExtension[]

  @@index([workspace_id, status])
  @@index([status, expires_at])
  @@map("call_reservations")
}

model CallReservationExtension {
  id              String   @id @default(uuid())
  reservation_id  String
  call_id         String
  workspace_id    String
  extension_index Int
  idempotency_key String   @unique
  amount_micro    BigInt
  created_at      DateTime @default(now())

  reservation CallReservation @relation(fields: [reservation_id], references: [id], onDelete: Cascade)
  call        Call            @relation(fields: [call_id], references: [id], onDelete: Cascade)
  workspace   Workspace       @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@index([reservation_id])
  @@index([call_id])
  @@map("call_reservation_extensions")
}

enum ReportVisibility {
  PERSONAL
  SHARED
}

model SavedReport {
  id                 String           @id @default(uuid())
  workspace_id       String
  created_by_user_id String
  name               String
  visibility         ReportVisibility @default(PERSONAL)
  configuration      Json
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  creator   Profile   @relation(fields: [created_by_user_id], references: [id], onDelete: Cascade)

  @@index([workspace_id])
  @@index([workspace_id, visibility])
  @@index([workspace_id, created_by_user_id])
  @@map("saved_reports")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  group       String
  description String
  created_at  DateTime @default(now())

  workspaceMemberPermissions WorkspaceMemberPermission[]

  @@map("permissions")
}

enum ResourceScopeType {
  ALL
  ASSIGNED
  CAMPAIGN
  PHONE_NUMBER
  BUYER
  VENDOR
}

model WorkspaceMemberPermission {
  id                  String   @id @default(uuid())
  workspace_id        String
  workspace_member_id String
  permission_id       String
  scope_type          ResourceScopeType @default(ALL)
  resource_id         String?
  created_at          DateTime @default(now())

  workspace       Workspace       @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  workspaceMember WorkspaceMember @relation(fields: [workspace_member_id], references: [id], onDelete: Cascade)
  permission      Permission      @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@index([workspace_id])
  @@map("workspace_member_permissions")
}

model SecurityAuditLog {
  id               String   @id @default(uuid())
  workspace_id     String
  actor_user_id    String?
  actor_member_id  String?
  action           String
  target_type      String?
  target_id        String?
  metadata         Json?
  created_at       DateTime @default(now())

  workspace        Workspace        @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  actor_member     WorkspaceMember? @relation("AuditLogActor", fields: [actor_member_id], references: [id], onDelete: SetNull)

  @@index([workspace_id, created_at])
  @@index([actor_user_id])
  @@index([target_type, target_id])
  @@map("security_audit_logs")
}

enum CommercialStatus {
  PENDING
  FINAL
  ADJUSTED
}

enum DisputeStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model CallCommercial {
  id                   String           @id @default(uuid())
  workspace_id         String
  call_id              String           @unique
  campaign_id          String
  vendor_id            String?
  buyer_id             String?

  qualified            Boolean          @default(false)
  converted            Boolean          @default(false)
  duplicate            Boolean          @default(false)
  duplicate_of_call_id String?

  currency             String
  revenue              Decimal          @default(0.0000) @db.Decimal(12, 4)
  payout               Decimal          @default(0.0000) @db.Decimal(12, 4)
  cost                 Decimal          @default(0.0000) @db.Decimal(12, 4)
  profit               Decimal          @default(0.0000) @db.Decimal(12, 4)

  status               CommercialStatus @default(PENDING)
  finalizes_at         DateTime?

  created_at           DateTime         @default(now())
  updated_at           DateTime         @updatedAt

  workspace            Workspace        @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  call                 Call             @relation(fields: [call_id], references: [id], onDelete: Restrict)
  campaign             Campaign         @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  duplicate_of_call    Call?            @relation("DuplicateOfCall", fields: [duplicate_of_call_id], references: [id], onDelete: SetNull)
  vendor               Vendor?          @relation(fields: [vendor_id], references: [id], onDelete: SetNull)
  buyer                Buyer?           @relation(fields: [buyer_id], references: [id], onDelete: SetNull)
  dispute              CallDispute?
  adjustment           CallFinancialAdjustment?

  @@index([workspace_id, status])
  @@index([campaign_id, created_at])
  @@index([vendor_id])
  @@index([buyer_id])
  @@map("call_commercials")
}

model CallDispute {
  id                  String         @id @default(uuid())
  workspace_id        String
  call_commercial_id  String         @unique
  buyer_id            String
  reason              String
  description         String?
  status              DisputeStatus  @default(PENDING)

  created_by_user_id  String
  resolved_by_user_id String?
  resolution_notes    String?
  resolved_at         DateTime?

  created_at          DateTime       @default(now())
  updated_at          DateTime       @updatedAt

  workspace           Workspace      @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  commercial          CallCommercial @relation(fields: [call_commercial_id], references: [id], onDelete: Cascade)
  buyer               Buyer          @relation(fields: [buyer_id], references: [id], onDelete: Cascade)
  adjustment          CallFinancialAdjustment?

  @@index([workspace_id, status])
  @@map("call_disputes")
}

model CallFinancialAdjustment {
  id                 String         @id @default(uuid())
  workspace_id       String
  call_commercial_id String         @unique
  dispute_id         String         @unique

  original_revenue   Decimal        @db.Decimal(12, 4)
  original_payout    Decimal        @db.Decimal(12, 4)
  adjusted_revenue   Decimal        @db.Decimal(12, 4)
  adjusted_payout    Decimal        @db.Decimal(12, 4)
  reason             String
  created_at         DateTime       @default(now())

  workspace          Workspace      @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  commercial         CallCommercial @relation(fields: [call_commercial_id], references: [id], onDelete: Cascade)
  dispute            CallDispute    @relation(fields: [dispute_id], references: [id], onDelete: Cascade)

  @@index([workspace_id])
  @@map("call_financial_adjustments")
}


