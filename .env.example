TELEPHONY_PROVIDER=telnyx

# DATABASE
DATABASE_URL=postgres://user:password@localhost:5432/callflow
DIRECT_URL=postgres://user:password@localhost:5432/callflow

# AUTH (Supabase JWKS)
SUPABASE_URL=https://your-supabase-project.supabase.co

# TELNYX
TELNYX_API_KEY=your_telnyx_api_key_here
TELNYX_PUBLIC_KEY=your_telnyx_public_key_here
TELNYX_CALL_CONTROL_APP_ID=your_telnyx_app_id_here
# RINGBACK_AUDIO_URL=https://your-domain.com/telephony/ringback.wav # Optional: overrides default ${BASE_URL}/telephony/ringback.wav

# TWILIO (Optional if using Telnyx)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# WORKSPACE CUSTOMER TELEPHONY USAGE BILLING RATES (USD per minute)
TELEPHONY_LOCAL_INBOUND_RATE=0.045
TELEPHONY_TOLL_FREE_RATE=0.055
TELEPHONY_RECORDING_STORAGE_RATE=0.0025

# STRIPE
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# SECURITY
WEBHOOK_ENCRYPTION_KEY=your_32_character_encryption_key_here

# COMMON
BASE_URL=https://your-ngrok-or-domain.com
PORT=3000
FRONTEND_URL=http://localhost:3001

# EMAIL / PASSWORD RECOVERY
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM=no-reply@callflow.io
RESET_TOKEN_EXPIRY_MINUTES=60
RESET_PASSWORD_URL=http://localhost:3001
