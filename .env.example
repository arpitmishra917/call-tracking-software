TELEPHONY_PROVIDER=telnyx

# TELNYX
TELNYX_API_KEY=your_telnyx_api_key_here
TELNYX_PUBLIC_KEY=your_telnyx_public_key_here

# Existing Telnyx Call Control / Voice API Application ID
# Reuse the same application for purchased CallFlow phone numbers.
TELNYX_CALL_CONTROL_APP_ID=

# TWILIO
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# COMMON
BASE_URL=https://your-ngrok-or-domain.com
PORT=3000
